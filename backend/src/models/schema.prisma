generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String   @id @default(uuid())
    username  String
    email     String   @unique
    status    Status   @default(OFFLINE)
    createdAt DateTime @default(now())
    isDeleted Boolean  @default(false)
    profile   Profile?

    // Group Relations
    ownedGroups  Groups[]       @relation("GroupOwner")
    groupsJoined GroupMembers[]

    // Content Relations
    posts     Posts[]
    comments  Comments[]
    reactions Reactions[]

    // Private Messaging Relations
    sentMessages      PrivateChats[]  @relation("SentMessages")
    receivedMessages  PrivateChats[]  @relation("ReceivedMessages")
    notifications     Notifications[] @relation("NotificationRecipient")
    sentNotifications Notifications[] @relation("NotificationSender")
    refreshTokens     RefreshToken[]
}

model Groups {
    id        String   @id @default(uuid())
    name      String   @unique
    profile   Profile?
    createdAt DateTime @default(now())
    isDeleted Boolean  @default(false)
    deletedAt DateTime?

    ownerId String
    owner   User   @relation("GroupOwner", fields: [ownerId], references: [id])

    members GroupMembers[]
    posts   Posts[]
}

model Profile {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    // Basic Info
    bio       String?
    avatarUrl String?
    location  String?
    website   String?

    //user relations
    userId  String? @unique
    user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
    //group relations
    groupId String? @unique
    group   Groups? @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model GroupMembers {
    id      String   @id @default(uuid())
    created DateTime @default(now())

    groupId String
    group   Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, groupId]) // Prevents a user joining the same group twice
}

model Posts {
    id      String   @id @default(uuid())
    text    String? // Optional in case of image-only posts
    imgUrl  String? // Optional in case of text-only posts
    created DateTime @default(now())

    userId String
    author User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    groupId String
    group   Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

    comments      Comments[]
    reactions     Reactions[]
    notifications Notifications[]
}

model Comments {
    id      String   @id @default(uuid())
    text    String
    created DateTime @default(now())

    postId String
    post   Posts  @relation(fields: [postId], references: [id], onDelete: Cascade)

    userId String
    author User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Threading logic: Comments can have replies
    parentId      String?
    parent        Comments?       @relation("CommentReplies", fields: [parentId], references: [id])
    replies       Comments[]      @relation("CommentReplies")
    notifications Notifications[]
}

model PrivateChats {
    id      String   @id @default(uuid())
    text    String? // Optional in case of image-only posts
    imgUrl  String? // Optional in case of text-only posts
    read    Boolean  @default(false)
    created DateTime @default(now())

    senderId String
    sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

    receiverId    String
    receiver      User            @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
    notifications Notifications[]
    reactions     Reactions[]
}

model Reactions {
    id      String   @id @default(uuid())
    emoji   String
    created DateTime @default(now())

    postId String?
    post   Posts?  @relation(fields: [postId], references: [id], onDelete: Cascade)

    chatId String?
    chat   PrivateChats? @relation(fields: [chatId], references: [id], onDelete: Cascade)

    userId        String
    user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    notifications Notifications[]

    @@unique([userId, postId]) // one reaction per user per post
    @@unique([userId, chatId]) // one reaction per user per chat
}

model Notifications {
    id        String           @id @default(uuid())
    type      NotificationType @default(MESSAGE)
    message   String? // optional human-readable text
    createdAt DateTime         @default(now())
    read      Boolean          @default(false)

    // Who triggered the notification (the sender of the action)
    senderId   String?
    sender     User?   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
    // Who received the notification (the receiver)
    receiverId String?
    receiver   User?   @relation("NotificationRecipient", fields: [receiverId], references: [id], onDelete: SetNull)

    // Activity references (always tied back to a Post if group-related)
    postId String?
    post   Posts?  @relation(fields: [postId], references: [id], onDelete: Cascade)

    commentId String?
    comment   Comments? @relation(fields: [commentId], references: [id], onDelete: Cascade)

    reactionId String?
    reaction   Reactions? @relation(fields: [reactionId], references: [id], onDelete: Cascade)

    chatId String?
    chat   PrivateChats? @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model RefreshToken {
    id        String   @id @default(uuid())
    token     String   @unique
    userId    String   @unique
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    expiresAt DateTime

    @@unique([userId, token])
    @@index([userId]) // speeds up queries by user
}

enum Status {
    ONLINE
    OFFLINE
}

enum NotificationType {
    COMMENT
    REACTION
    MESSAGE
    GROUP_INVITE
}
